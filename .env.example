# PanelManager Environment Configuration
PORT=3001
WEB_PORT=3000
DATA_DIR=./data
# 32-byte hex or arbitrary passphrase used to derive AES-256-GCM encryption key
PANEL_SECRET=change-this-to-a-long-random-secret-key-at-least-32-chars
# Optional remote Docker Swarm manager (e.g. ssh://root@your-vps-ip or tcp://...)
# DOCKER_HOST=
# Public URL of the panel (used for webhook callback URLs)
PANEL_PUBLIC_URL=http://localhost:3000
# Next.js client/server API URL
NEXT_PUBLIC_API_URL=http://localhost:3001
INTERNAL_API_URL=http://127.0.0.1:3001
